# Taps
{{- range .brews.taps }}
tap "{{ .name }}"{{ if hasKey . "url" }}, "{{ .url }}"{{ end }}
{{- end }}

# CLI
{{- range .brews.formulas }}
brew "{{ . }}"
{{- end }}

# Apps
{{- range .brews.casks }}
cask "{{ . }}"
{{- end }}

# Mac App Store
{{- range .brews.mas }}
mas "{{ .name }}", id: {{ .id }}
{{- end }}
