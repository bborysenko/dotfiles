{{- $p := dig .profile (dict) .profiles -}}
{{- $brews := dig "brews" (dict) $p -}}

# Taps
{{- range dig "taps" list $brews }}
tap "{{ .name }}"{{ if hasKey . "url" }}, "{{ .url }}"{{ end }}
{{- end }}

# CLI
{{- range dig "formulas" list $brews }}
brew "{{ . }}"
{{- end }}

# Apps
{{- range dig "casks" list $brews }}
cask "{{ . }}"
{{- end }}

# Mac App Store
{{- range dig "mas" list $brews }}
mas "{{ .name }}", id: {{ .id }}
{{- end }}
