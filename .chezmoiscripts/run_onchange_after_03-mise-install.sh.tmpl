{{- if eq .chezmoi.os "darwin" -}}
{{- $p := dig .profile (dict) .profiles -}}
{{- $miseTools := list -}}
{{- range dig "mise" "tools" list $p -}}
{{-   if contains ":" . -}}
{{-     $miseTools = append $miseTools (split ":" .)._0 -}}
{{-   else -}}
{{-     $miseTools = append $miseTools . -}}
{{-   end -}}
{{- end -}}
#!/bin/bash
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}-{{ include ".chezmoidata.yaml" | sha256sum }}
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

{{- $hasPython := has "python" $miseTools }}
{{- $hasGcloud := has "gcloud" $miseTools }}

{{ if $hasPython }}
# Install Python first (required by gcloud)
mise install python --yes
{{ if $hasGcloud }}
# Ensure gcloud uses mise Python during installation (not system Python 3.9)
export CLOUDSDK_PYTHON="$(mise which python)"
{{ end }}
{{ end }}

# Install remaining tools
mise install --yes
{{ end -}}
